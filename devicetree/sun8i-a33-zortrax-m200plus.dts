&usb_otg {
	//dr_mode = "host";
	status = "disabled";
	dr_mode = "otg";
	//status = "okay";
};

&usbphy {
	compatible = "allwinner,sun8i-a23-usb-phy";
    usb0_id_det-gpios = <&pio 7 8 GPIO_ACTIVE_HIGH>; // PH08: port H (7), pin 8
	// VBUS detection from AXP221 internally, no AXP223 GPIO is connected to VBUS
	// does not work usb0_vbus_det-gpio = <&axp_gpio 1 GPIO_ACTIVE_HIGH>; // AXP221 GPIO1 has also the POWER label and toggles at the same time as VBUS on kernel start
	//usb0_vbus_det-gpio = <&axp_gpio 0 GPIO_ACTIVE_HIGH>;
	// Non sense pin
	//usb0_vbus_det-gpio = <&pio 1 3 GPIO_ACTIVE_HIGH>; // PB3 does not work neither
	//platform 1c1a000.usb: deferred probe pending: platform: supplier 1c19400.phy not ready
    usb0_vbus-supply = <&reg_dcdc1>;
	// non standard 
	usb0_vbus_power-supply = <&usb_power_supply>; // USB1 VBUS is always on
	// standard
    usb0_vbus-supply = <&reg_drivevbus>; // AXP223 regulated 5V for USB OTG
	// non standard 
    usb1_vbus_power-supply = <&usb_power_supply>; // USB1 VBUS is always on
	// standard
	usb1_vbus-supply = <&usb_power_supply>; // USB1 VBUS is always on
    status = "okay";
};
*/

&usb_otg {
	dr_mode = "otg";
	status = "disabled";
};

&usb_power_supply {
	status = "okay";
};

&usbphy {
	status = "okay";
};


&pio {
    vcc-pa-supply = <&reg_dcdc1>;
    vcc-pb-supply = <&reg_dcdc1>;
    vcc-pc-supply = <&reg_dcdc1>;
    //vcc-pe-supply = <&reg_eldo2>;
    vcc-pe-supply = <&reg_dcdc1>;
    vcc-pf-supply = <&reg_dcdc1>;
    vcc-pg-supply = <&reg_dcdc1>;
	vcc-ph-supply = <&reg_dcdc1>;
    //vcc-pl-supply = <&reg_dldo1>; // Not clear, but reg not found in the kernel start
	vcc-pl-supply = <&reg_dcdc1>;

	uart0_pf_pins: uart0-pf-pins {
		allwinner,pins = "PF2", "PF4";
		allwinner,function = "uart0";
	};

    // MCU connection: PB0/PB1 used for UART2
    uart2_pb_pins: uart2-pb-pins {
		allwinner,pins = "PB0", "PB1";
		allwinner,function = "uart2";
	};

    /* PB3 "Clear To Send" in conflict with power button led gpio...
    uart2_cts_rts_pb_pins: uart2-cts-rts-pb-pins {
        pins = "PB2", "PB3";
        function = "uart2";
    };
    */

    wifi_pwrseq: wifi-pwrseq {
        compatible = "mmc-pwrseq-simple";
        reset-gpios = <&pio 11 6 GPIO_ACTIVE_HIGH>; // PL6
    };
    /*
	wireless-bluetooth {
		bt_wake_pin: bt-wake-pin {
			allwinner,pins = <11 10 GPIO_ACTIVE_HIGH &pcfg_pull_none>;
		};

		bt_host_wake_pin: bt-host-wake-pin {
			allwinner,pins = <11 9 GPIO_ACTIVE_HIGH &pcfg_pull_none>;
		};

		bt_reset_pin: bt-reset-pin {
			allwinner,pins = <11 8 GPIO_ACTIVE_HIGH &pcfg_pull_none>;
		};
	};
    */
};


