&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pb_pins>;
	status = "okay";
};

/*
[gpio_para]
gpio_used = 1
gpio_pin_1 = port:PB02<1><default><default><0>  pin 3 on P4 -> power button LED
gpio_pin_2 = port:PB03<1><default><default><0>  ?
gpio_pin_3 = port:PE17<1><default><default><1>  ?
gpio_pin_4 = port:PH01<1><default><default><0>  PIN_VALUE_FILE="/sys/class/gpio_sw/PH1/data" 1=USB_slave 0=USB Host in usb_mode_script.sh -> connected to usb ID pin 49 PH08 of the SOM
gpio_pin_5 = port:PC01<1><default><default><0>  Pin named GPIO on P3
gpio_pin_6 = port:PC00<1><default><default><0>  Pin named ALDOHC on P3
gpio_pin_7 = port:PC02<1><default><default><1>  Pin named BOOT on P3
gpio_pin_8 = port:PC03<0><1><default><0>        Pin named GPIOS on P3
gpio_pin_9 = port:PF01<1><default><default><0>  Pin named NRST on P3
gpio_pin_10 = port:PF00<1><default><default><0> Pin named SLP on P3

In uboot:
gpio set 225      # Set PH01 high 1=USB_slave
gpio clear 225    # Set PH01 low  0=USB Host
gpio input 225    # Set PH01 as input (tristate)

p3 = +3V SW LED GND GND GND DP DN VBUS VBUS
SW seems unconnected to the SOM, hence the useless switch on the printer, probably that they did not latch the power off state.

SOM's USBDRVVBUS goes to a transistor that powers VBUS or not
*/

&i2c0 {
    status = "okay";

    touchscreen@38 {
        compatible = "focaltech,ft5x06";
        reg = <0x38>;
        interrupt-parent = <&pio>;
		interrupts = <1 5 IRQ_TYPE_EDGE_FALLING>; // PB05: port B (1), pin 5
        reset-gpios = <&pio 6 10 GPIO_ACTIVE_HIGH>; // PG10: port G (6), pin 10
        touchscreen-size-x = <480>;
        touchscreen-size-y = <800>;
        touchscreen-inverted-x = <0>;
        touchscreen-inverted-y = <1>;
        touchscreen-swapped-x-y = <0>;
        wakeup-source;
        status = "okay";
    };
};

